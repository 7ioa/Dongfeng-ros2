  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <left_joint>wheel_left_front_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <right_joint>wheel_right_front_joint</right_joint>
      <wheel_separation>0.132</wheel_separation>
      <wheel_radius>0.028</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <min_linear_velocity>-0.25</min_linear_velocity>
      <max_linear_velocity>0.25</max_linear_velocity>
      <min_angular_velocity>-1.2</min_angular_velocity>
      <max_angular_velocity>1.2</max_angular_velocity>
      <min_linear_acceleration>-0.6</min_linear_acceleration>
      <max_linear_acceleration>0.6</max_linear_acceleration>
      <min_angular_acceleration>-2.4</min_angular_acceleration>
      <max_angular_acceleration>2.4</max_angular_acceleration>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>
